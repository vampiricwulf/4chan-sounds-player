{
  "name": "4chan-sounds-player",
  "version": "3.7.2",
  "description": "Play that faggy music weeb boi",
  "main": "main.js",
  "scripts": {
    "build": "node build.js && npm run build-greasyfork",
    "build-beta": "node build.js --env filename=4chan-sounds-player-beta --env build-number",
    "build-greasyfork": "node build.js --env filename=4chan-sounds-player-greasyfork --env no-minify",
    "build-dev": "node build.js --mode development --env gitcdn --env build-number",
    "lint": "eslint .",
    "test:util": "node test/video-util.test.js",
    "test": "node test/video-util.test.js && node test/parse-action.test.js && node test/docs-coverage.test.js && node test/user-template.test.js && node test/posts-filename.test.js",
    "docs": "node scripts/build-docs.js"
  },
  "author": "rcc11",
  "license": "CC0-1.0",
  "devDependencies": {
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "minimist": "^1.2.8",
    "raw-loader": "^4.0.2",
    "sass": "^1.26.5",
    "sass-loader": "^8.0.2",
    "terser-webpack-plugin": "^5.1.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "bootstrap-icons": "^1.3.0"
  }
}
